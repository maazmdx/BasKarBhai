<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_modal_card"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_flame"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Android 13+ Setup Guide"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Google Android 13 &amp; 14 blocks sideloaded apps from enabling Accessibility Services by default under 'Restricted Settings'. Follow these 3 simple steps to unlock:"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="16dp" />

    <!-- Step 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:background="#161B22"
        android:padding="12dp">

        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_badge"
            android:text="1"
            android:textColor="@color/flame_orange"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Tap the button below to open BasKarBhai's App Info page."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Step 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:background="#161B22"
        android:padding="12dp">

        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_badge"
            android:text="2"
            android:textColor="@color/flame_orange"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="In App Info, tap the 3-dot menu (⋮) in the top-right corner."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Step 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="18dp"
        android:background="#161B22"
        android:padding="12dp">

        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_badge"
            android:text="3"
            android:textColor="@color/flame_orange"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Select 'Allow restricted settings' and confirm with fingerprint/PIN. Then return to Accessibility!"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnOpenAppInfo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_primary"
        android:text="Open App Info Settings"
        android:textColor="@color/on_primary"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnDismissGuide"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_button_secondary"
        android:text="Got It"
        android:textColor="@color/text_primary"
        android:textAllCaps="false" />
</LinearLayout>
