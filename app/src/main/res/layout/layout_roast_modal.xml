<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modalRootOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ED05070A"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/modalCardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_modal_card"
        android:orientation="vertical"
        android:elevation="24dp">

        <!-- Top Graphic Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#0A0E14"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivMemeImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Intervention Visual"
                android:src="@drawable/art_tier1_reality_check" />

            <!-- Tier Status Pill -->
            <TextView
                android:id="@+id/tvTierBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_badge"
                android:text="⚠️ TIER 1 • DETOX"
                android:textColor="#FFAB00"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:elevation="4dp" />
        </FrameLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#21262D" />

        <!-- Card Content Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="18dp"
            android:paddingBottom="22dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvRoastTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REALITY CHECK"
                android:textColor="#F0F6FC"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04" />

            <!-- Caption / Voice Roast Text -->
            <TextView
                android:id="@+id/tvRoastCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="You've scrolled through 10 reels back-to-back.\nThat’s pure dopamine fog. Look up, take a breath, and put the phone down."
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />

            <!-- Live Session Stats Pill -->
            <TextView
                android:id="@+id/tvModalStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_badge"
                android:text="10 Reels  •  05:00 Wasted"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Action Button -->
            <Button
                android:id="@+id/btnModalAction"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_primary"
                android:text="I Will Put Phone Down"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:elevation="6dp" />

            <!-- Hint / Contributor Footer -->
            <TextView
                android:id="@+id/tvActionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="BasKarBhai • Protected by maazmdx"
                android:textColor="#484F58"
                android:textSize="11sp"
                android:textAlignment="center" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
