<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.BasKarBhai" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/flame_orange</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:statusBarColor">@color/bg_dark_primary</item>
        <item name="android:navigationBarColor">@color/bg_dark_primary</item>
        <item name="android:windowBackground">@color/bg_dark_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Dialog style -->
    <style name="Theme.BasKarBhai.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.85</item>
    </style>
</resources>
